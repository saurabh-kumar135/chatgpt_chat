# Functional tests
# ---------------------------------------------------------------------------
TEST_PROMPTS = [
    "suggest me some homes",
    "suggest me some homes in Bijnor",
    "show me cheap homes under 2000",
    "find highly rated homes",
    "show my bookings",
    "what is the price of Home ABC",
    "cancel my booking because I found another place; I booked the alternative accommodation yesterday",
    "show my favourites",
    "add Home ABC to my favourites",
    "predict the dynamic price for homes in Bijnor",
]


def run_tests():
    for user_text in TEST_PROMPTS:
        print("=" * 90)
        print("USER:", user_text)
        try:
            result = generate_tool_call(user_text)
            print("TOOL CALL:")
            print(json.dumps(result, indent=2, ensure_ascii=False))
        except Exception as exc:
            print("ERROR:", type(exc).__name__, exc)

run_tests()

# ---------------------------------------------------------------------------
# Negative grammar tests
# ---------------------------------------------------------------------------
INVALID_CASES = [
    '{"name":"searchHomes","arguments":{"price":2000}}',
    '{"name":"cancelBooking","arguments":{"reason":"Found another place","reasonDetails":"Booked another accommodation yesterday"}}',
    '```json\n{"name":"searchHomes","arguments":{}}\n```',
    '[TOOL_CALLS]{"name":"searchHomes","arguments":{}}',
    '[{"name":"searchHomes","arguments":{}}]',
    '{"name":"searchHomes","arguments":{"foo":"bar"}}',
    '{"name":"cancelBooking","arguments":{"cancelAll":true,"reason":"Other solid reason","reasonDetails":"Need to cancel this booking"}}',
    '{"name":"createBooking","arguments":{"location":"Bijnor","homeName":"Home ABC"}}',
    '{"name":"cancelBooking","arguments":{"reason":"Found alternative accommodation"}}',
]

for invalid in INVALID_CASES:
    assert not grammar_accepts_prefix(invalid), f"Unexpectedly accepted: {invalid}"

print("NEGATIVE GRAMMAR TESTS: PASS")
print("CFG is active through logits_processor=[processor].")
print("Keep validate_tool_call() before HavenTo execute_tool() in production.")
