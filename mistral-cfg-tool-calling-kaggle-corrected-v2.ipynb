# ---------------------------------------------------------------------------
# Exact post-generation schema validator
# ---------------------------------------------------------------------------
def _is_number(x: Any) -> bool:
    return isinstance(x, (int, float)) and not isinstance(x, bool)


def _validate_value(value: Any, spec: Dict[str, Any], path: str) -> None:
    t = spec["type"]
    if t == "string":
        if not isinstance(value, str):
            raise ValueError(f"{path} must be a string")
    elif t == "number":
        if not _is_number(value):
            raise ValueError(f"{path} must be a number")
    elif t == "integer":
        if not isinstance(value, int) or isinstance(value, bool):
            raise ValueError(f"{path} must be an integer")
    elif t == "array":
        if not isinstance(value, list):
            raise ValueError(f"{path} must be an array")
        for i, item in enumerate(value):
            _validate_value(item, spec["items"], f"{path}[{i}]")
    else:
        raise ValueError(f"Unsupported schema type: {t}")
    if "enum" in spec and value not in spec["enum"]:
        raise ValueError(f"{path} must be one of {spec['enum']}")


def validate_tool_call(obj: Any) -> Dict[str, Any]:
    if not isinstance(obj, dict):
        raise ValueError("Top level must be a JSON object")
    if set(obj.keys()) != {"name", "arguments"}:
        raise ValueError("Top level must contain exactly name and arguments")
    name, arguments = obj["name"], obj["arguments"]
    if name not in TOOLS:
        raise ValueError(f"Unknown tool: {name}")
    if not isinstance(arguments, dict):
        raise ValueError("arguments must be a JSON object")
    schema = TOOLS[name]
    unknown = set(arguments) - set(schema["properties"])
    if unknown:
        raise ValueError(f"Unknown argument(s) for {name}: {sorted(unknown)}")
    missing = [k for k in schema["required"] if k not in arguments]
    if missing:
        raise ValueError(f"Missing required argument(s) for {name}: {missing}")
    for key, value in arguments.items():
        _validate_value(value, schema["properties"][key], f"arguments.{key}")
    return {"name": name, "arguments": arguments}

# ---------------------------------------------------------------------------
# Compile a strict JSON grammar from the public schemas
# ---------------------------------------------------------------------------
JSON_STRING = r'"(?:\\(?:["\\/bfnrt]|u[0-9a-fA-F]{4})|[^"\\\x00-\x1F])*"'
JSON_NUMBER = r'-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?'
JSON_INTEGER = r'-?(?:0|[1-9][0-9]*)'


def _json_string_literal(value: str) -> str:
    return re.escape(json.dumps(value, ensure_ascii=False, separators=(",", ":")))


def _value_regex(spec: Dict[str, Any]) -> str:
    if "enum" in spec:
        return "(?:" + "|".join(_json_string_literal(v) for v in spec["enum"]) + ")"
    if spec["type"] == "string":
        return JSON_STRING
    if spec["type"] == "number":
        return JSON_NUMBER
    if spec["type"] == "integer":
        return JSON_INTEGER
    if spec["type"] == "array":
        if spec["items"].get("type") != "string":
            raise ValueError("Only string arrays are supported")
        item = JSON_STRING
        return rf"\[(?:{item}(?:,{item})*)?\]"
    raise ValueError(f"Unsupported grammar type: {spec['type']}")


def _argument_object_regex(schema: Dict[str, Any]) -> str:
    properties = schema["properties"]
    required = set(schema["required"])
    keys = list(properties)
    if not keys:
        return r"\{\}"

    alternatives = []
    # Allow every valid subset/permutation. Required keys must be present.
    for length in range(len(keys) + 1):
        for chosen in itertools.permutations(keys, length):
            if not required.issubset(chosen):
                continue
            fields = [
                re.escape(json.dumps(k, ensure_ascii=False)) + ":" + _value_regex(properties[k])
                for k in chosen
            ]
            alternatives.append(r"\{" + ",".join(fields) + r"\}")
    return "(?:" + "|".join(sorted(set(alternatives), key=len, reverse=True)) + ")"


TOOL_GRAMMARS = {}
for tool_name, schema in TOOLS.items():
    pattern = (
        r'\{"name":' + _json_string_literal(tool_name) +
        r',"arguments":' + _argument_object_regex(schema) + r"\}"
    )
    TOOL_GRAMMARS[tool_name] = regex.compile(pattern)

COMBINED_GRAMMAR = regex.compile(
    "(?:" + "|".join(p.pattern for p in TOOL_GRAMMARS.values()) + ")"
)


def grammar_accepts_complete(text: str) -> bool:
    return COMBINED_GRAMMAR.fullmatch(text) is not None


def grammar_accepts_prefix(text: str) -> bool:
    return COMBINED_GRAMMAR.fullmatch(text, partial=True) is not None


# Sanity checks corresponding to the failures seen in the previous notebook.
assert grammar_accepts_complete('{"name":"searchHomes","arguments":{}}')
assert grammar_accepts_complete('{"name":"searchHomes","arguments":{"maxPrice":2000}}')
assert grammar_accepts_complete(
    '{"name":"cancelBooking","arguments":{"reason":"Found alternative accommodation",'
    '"reasonDetails":"Booked another accommodation yesterday"}}'
)
assert not grammar_accepts_prefix('{"name":"searchHomes","arguments":{"price":2000}}')
assert not grammar_accepts_prefix(
    '{"name":"cancelBooking","arguments":{"reason":"Found another place"}'
)
assert not grammar_accepts_prefix('[TOOL_CALLS]{"name":"searchHomes","arguments":{}}')
print("Grammar sanity checks: PASS")

# ---------------------------------------------------------------------------
# Tokenizer-aware constrained decoding
# ---------------------------------------------------------------------------
class HavenToCFGLogitsProcessor(LogitsProcessor):
    def __init__(self, tokenizer, prompt_len: int, eos_token_id: int):
        self.tokenizer = tokenizer
        self.prompt_len = prompt_len
        self.eos_token_id = eos_token_id
        self.vocab_size = len(tokenizer)
        self.token_text_cache: Dict[int, str] = {}
        self.prefix_token_cache: Dict[Tuple[str, int], bool] = {}

    def _decode_token(self, token_id: int) -> str:
        if token_id not in self.token_text_cache:
            self.token_text_cache[token_id] = self.tokenizer.decode(
                [token_id],
                skip_special_tokens=False,
                clean_up_tokenization_spaces=False,
            )
        return self.token_text_cache[token_id]

    def _generated_text(self, input_ids: torch.LongTensor) -> str:
        suffix = input_ids[0, self.prompt_len:].tolist()
        return self.tokenizer.decode(
            suffix,
            skip_special_tokens=False,
            clean_up_tokenization_spaces=False,
        )

    def __call__(self, input_ids: torch.LongTensor, scores: torch.FloatTensor) -> torch.FloatTensor:
        if input_ids.shape[0] != 1:
            raise ValueError("Batch size 1 is required by this implementation")

        prefix = self._generated_text(input_ids)

        # After the JSON object is complete, EOS is the only legal token.
        if grammar_accepts_complete(prefix):
            masked = torch.full_like(scores, float("-inf"))
            masked[0, self.eos_token_id] = scores[0, self.eos_token_id]
            return masked

        scores = scores.clone()
        scores[0, self.eos_token_id] = float("-inf")

        allowed = torch.zeros(self.vocab_size, dtype=torch.bool, device=scores.device)
        for token_id in range(self.vocab_size):
            token_text = self._decode_token(token_id)
            if not token_text:
                continue
            key = (prefix, token_id)
            ok = self.prefix_token_cache.get(key)
            if ok is None:
                ok = grammar_accepts_prefix(prefix + token_text)
                self.prefix_token_cache[key] = ok
            if ok:
                allowed[token_id] = True

        if not bool(allowed.any()):
            raise RuntimeError(f"CFG dead-end at prefix: {prefix!r}")

        scores[0, ~allowed] = float("-inf")
        return scores

# ---------------------------------------------------------------------------
# Prompt + generation
# ---------------------------------------------------------------------------
def _prompt_for_tool_call(user_text: str) -> str:
    return f"""You are HavenTo's tool router.

Convert the user's request into exactly ONE tool call.
Output ONLY the JSON object.
Do not output Markdown, ```json, [TOOL_CALLS], an array, explanations,
or any text before or after the JSON object.
Use only public HavenTo tool names and public argument names.
Use exact enum values when an enum is required.

User request:
{user_text}

JSON tool call:
"""


def generate_tool_call(user_text: str, max_new_tokens: int = 256) -> Dict[str, Any]:
    prompt = _prompt_for_tool_call(user_text)
    inputs = tokenizer(prompt, return_tensors="pt", add_special_tokens=True)

    input_device = model.get_input_embeddings().weight.device
    input_ids = inputs["input_ids"].to(input_device)
    attention_mask = inputs["attention_mask"].to(input_device)
    prompt_len = input_ids.shape[1]

    processor = HavenToCFGLogitsProcessor(
        tokenizer=tokenizer,
        prompt_len=prompt_len,
        eos_token_id=tokenizer.eos_token_id,
    )

    output_ids = model.generate(
        input_ids=input_ids,
        attention_mask=attention_mask,
        max_new_tokens=max_new_tokens,
        do_sample=False,
        logits_processor=[processor],  # CRITICAL: actual constrained decoding
        eos_token_id=tokenizer.eos_token_id,
        pad_token_id=tokenizer.eos_token_id,
        use_cache=True,
    )

    generated_ids = output_ids[0, prompt_len:]
    raw_text = tokenizer.decode(
        generated_ids,
        skip_special_tokens=True,
        clean_up_tokenization_spaces=False,
    ).strip()

    # Deliberately no JSON extraction. The complete suffix must be JSON.
    if not raw_text:
        raise ValueError("Model generated no tool call")
    try:
        obj = json.loads(raw_text)
    except json.JSONDecodeError as exc:
        raise ValueError(f"Non-JSON constrained output: {raw_text!r}") from exc

    validate_tool_call(obj)
    if not grammar_accepts_complete(raw_text):
        raise ValueError(f"Output is outside the CFG language: {raw_text!r}")
    return obj

